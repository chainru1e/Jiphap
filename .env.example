# Supabase — 대시보드 Settings > API Keys
# 2025-11-01 이후 만든 프로젝트에는 legacy anon / service_role 키가 발급되지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이면 클라이언트 번들에 들어간다
SUPABASE_SECRET_KEY=

# 카카오 개발자 콘솔 — JavaScript 키 (T06)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# /api/cron/daily Bearer 검증용 (T32). 직접 정해 Vercel 환경변수에 등록한다
CRON_SECRET=
